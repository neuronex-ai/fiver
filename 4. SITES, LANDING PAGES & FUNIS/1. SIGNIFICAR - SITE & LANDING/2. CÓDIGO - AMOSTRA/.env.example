# URL pública final. O build usa esta variável para canonical, sitemap e dados estruturados.
VITE_SITE_URL=https://seu-dominio.com.br

# Dados públicos da clínica — preencher apenas com informações confirmadas.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_WHATSAPP_URL=
VITE_INSTAGRAM_URL=
VITE_CRP=
VITE_ADDRESS_STREET=
VITE_ADDRESS_CITY=
VITE_ADDRESS_REGION=
VITE_ADDRESS_POSTAL_CODE=

# Supabase será conectado em uma etapa posterior.
# Não coloque chaves reais neste arquivo versionado.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# IndexNow é opcional e só deve ser usado depois do domínio estar publicado.
INDEXNOW_KEY=
